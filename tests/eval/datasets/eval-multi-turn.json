    {
      "eval_case_id": "multi_turn_02_two_system_saga_compensation_rollback",
      "agent_data": {
        "agents": {
          "hr_supervisor_agent": {
            "agent_id": "hr_supervisor_agent",
            "agent_type": "LlmAgent",
            "instruction": "Delegate cross-system HRIS+IT workflows to it_service_agent."
          },
          "it_service_agent": {
            "agent_id": "it_service_agent",
            "agent_type": "LlmAgent",
            "instruction": "Execute two-system Saga across WorkWeek and ServiceImmediately with automatic rollback on failure.",
            "tools": [
              {
                "function_declarations": [
                  {
                    "name": "execute_two_system_saga",
                    "description": "Commits WorkWeek update then ServiceImmediately ticket; runs revert_hr_record if Step 2 fails.",
                    "parameters": {
                      "type": "OBJECT",
                      "properties": {
                        "proposal_id": {"type": "STRING"}
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "turns": [
          {
            "turn_index": 0,
            "events": [
              {
                "author": "user",
                "content": {
                  "role": "user",
                  "parts": [{"text": "I confirmed proposal prop-9920 to update my remote work location in WorkWeek and open a laptop shipping ticket in ServiceImmediately. What is the status?"}]
                }
              },
              {
                "author": "it_service_agent",
                "content": {
                  "role": "model",
                  "parts": [
                    {
                      "function_call": {
                        "name": "execute_two_system_saga",
                        "args": {"proposal_id": "prop-9920"}
                      }
                    }
                  ]
                }
              },
              {
                "author": "tool",
                "content": {
                  "role": "tool",
                  "parts": [
                    {
                      "function_response": {
                        "name": "execute_two_system_saga",
                        "response": {
                          "saga_status": "ROLLBACK_EXECUTED",
                          "step1_workweek_tx": "WW-TX-501",
                          "step2_error": "HTTP 503 ServiceImmediately Unavailable",
                          "compensation_action": "revert_hr_record(WW-TX-501) -> SUCCESS",
                          "retry_queue_task_id": "TASK-RETRY-77"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "author": "hr_supervisor_agent",
                "content": {
                  "role": "model",
                  "parts": [
                    {
                      "text": "While updating your remote work location in WorkWeek (`WW-TX-501`) initially succeeded, ServiceImmediately returned a temporary outage (`HTTP 503`) when creating your hardware ticket. To prevent inconsistent records, the system automatically executed a compensating rollback (`ROLLBACK_EXECUTED`) on `WW-TX-501` and queued your request (`TASK-RETRY-77`) in Cloud Tasks for safe automatic retry."
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
