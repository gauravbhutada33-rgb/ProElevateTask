# Enterprise HR Agentic Solution (MVP 1) — Environment Configuration Template
# Copy to `.env` for local development (`cp .env.example .env`).
# In Cloud Run production, sensitive secrets are injected via GCP Secret Manager.

# 1. Google Cloud & Vertex AI Agent Engine Configuration
PROJECT_NAME=hr-agentic-solution
GOOGLE_CLOUD_PROJECT=hr-agentic-prod
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_FAILOVER_LOCATION=us-east1

# 2. Locked Gemini 3.6 Models on Vertex AI Agent Engine
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-3.6-pro

# 3. Maria Santos (DPO) Safeguard: Vertex AI Zero Data Retention (ZDR)
VERTEX_AI_ZERO_DATA_RETENTION=true

# 4. Alex Rivera (IT Director) Safeguard: PostgreSQL 16 Parity & Unified <=60s Sync SLA
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hr_agentic
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# 5. Downstream API Token-Bucket Rate Limits & Cloud Tasks Queue
WORKWEEK_RPS_LIMIT=50
WORKWEEK_BURST_CAPACITY=100
SERVICEIMMEDIATELY_RPS_LIMIT=25
SERVICEIMMEDIATELY_BURST_CAPACITY=50
CLOUD_TASKS_RETRY_QUEUE=ww-it-mutation-retry-queue

# 6. Okta OIDC Production Federation (Pod 1)
OKTA_ISSUER_URI=https://login.enterprise.example.com/oauth2/default
OKTA_AUDIENCE=api://hr-agentic-solution
